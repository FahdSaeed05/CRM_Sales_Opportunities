----B2B sales pipeline data from a fictitious company that sells computer hardware, including information on accounts, products, sales teams, and sales opportunities.---(FROM Salesforce)



--1). How is each sales team performing compared to the rest?

--2). Are any sales agents lagging behind?

--3). Are there any quarter-over-quarter trends?




Do any products have better win rates?
--1) How is each sales team performing compared to the rest?

SELECT
	st.Manager,
	SUM(sp.Close_value) AS total_closed
FROM Sales_pipeline sp
JOIN Sales_teams st
	ON sp.sales_agent = st.sales_agent
GROUP BY st.manager
ORDER BY SUM(sp.Close_value) DESC

--2)Are any sales agents lagging behind?

SELECT
	Sales_agent,
	SUM(close_value) AS total_closed
FROM Sales_pipeline
GROUP BY Sales_agent
ORDER BY SUM(close_value)

-- 3)Are there any quarter-over-quarter trends?

WITH Quarterly_outcomes AS (
SELECT
	sales_agent,
	Year(Close_date) AS sales_year,
	DATEPART(quarter, close_date) AS sales_quarter,
	SUM(close_value) AS quarterly_sales,
	COUNT(*) AS closed_deals,
	SUM(
		CASE WHEN deal_stage = 'Won' THEN 1 ELSE 0
		END) AS won_deals,
	SUM(
		CASE WHEN deal_stage = 'Lost' THEN 1 ELSE 0
		END) AS lost_deals

From Sales_pipeline
WHERE deal_stage IN ('Won', 'Lost')
AND close_date IS NOT NULL
GROUP BY sales_agent, Year(Close_date), DATEPART(quarter, close_date)
ORDER BY quarterly_sales DESC
)

SELECT
	sales_year,
	sales_quarter,
	won_deals,
	lost_deals,
	ROUND(
		   100 * won_deals /NULLIF(closed_deals, 0), 2
		   ) AS win_prcnt
	FROM Quarterly_outcomes
	
	ORDER BY sales_year, sales_quarter;
			

			---- CTE calculating quarterly and years revenue

WITH Quarterly_sales AS (

SELECT
	Year(Close_date) AS sales_year,
	DATEPART(quarter, close_date) AS sales_quarter,
	SUM(close_value) AS Revenue,
	COUNT(*) AS closed_deals
FROM sales_pipeline
WHERE deal_stage IN ('won', 'lost')
GROUP BY Year(Close_date), DATEPART(quarter, close_date)

)

SELECT
	Sales_year,
	Sales_quarter,
	revenue,
	LAG(revenue) OVER(order by sales_year, sales_quarter) AS previous_quarter_revenue,
	ROUND(
		 100 * ( revenue - LAG(revenue)OVER(order by sales_year, sales_quarter)
		 ) / NULLIF(LAG(revenue)OVER(order by sales_year, sales_quarter), 0) , 2
		 ) AS Qoq_growth
	FROM quarterly_sales
	ORDER BY sales_year, sales_quarter

	--Do any products have better win rates?

	WITH Deal_won_lost AS (
	
	SELECT
		product,
		COUNT(*) AS close_count,
		SUM(
			CASE WHEN deal_stage = 'Won' THEN 1 ELSE 0
			END) AS deals_won,
		SUM(
			CASE WHEN deal_stage = 'lost' THEN 1 ELSE 0
			END) AS deals_lost
	FROM Sales_pipeline
	WHERE deal_stage IN ('Won', 'Lost')
	GROUP BY product
	)

	SELECT
		product,
		close_count,
		deals_won,
		deals_lost,
		ROUND(
				100.0 * deals_won/NULLIF(close_count, 0), 2)
		AS win_rate
	FROM deal_won_lost
	ORDER BY ROUND(
				100.0 * deals_won/NULLIF(close_count, 0), 2) DESC

--- Regional Analysis
		WITH Agent_performance AS (
		SELECT
			st.regional_office,
			st.manager,
			sp.sales_agent,
			COUNT(DISTINCT sp.opportunity_id) AS total_opportunities,
			COUNT(
				CASE WHEN sp.deal_stage = 'Won' THEN 1
			END) AS deals_won,
			SUM(CASE
				WHEN sp.deal_stage = 'Won'
				THEN sp.close_value
				ELSE 0
			END) AS total_revenue

		FROM sales_teams st
		JOIN Sales_pipeline sp
			ON st.sales_agent = sp.sales_agent
		GROUP BY st.regional_office, st.manager, sp.sales_agent
		)

		
		SELECT
			*,
			DENSE_RANK() OVER(PARTITION BY regional_office ORDER BY total_revenue DESC
			) AS regional_rank
		FROM Agent_performance
		ORDER BY regional_office, regional_rank

		-- Month over month regional performance
	WITH Agent_performance AS (
		SELECT
			st.regional_office,
			st.manager,
			sp.sales_agent,
			DATETRUNC(YEAR, sp.close_date) AS close_year,
			DATETRUNC(month, sp.close_date) AS close_month,
			COUNT(DISTINCT sp.opportunity_id) AS total_opportunities,
			COUNT(
				CASE WHEN sp.deal_stage = 'Won' THEN 1
			END) AS deals_won,
			SUM(CASE
				WHEN sp.deal_stage = 'Won'
				THEN sp.close_value
				ELSE 0
			END) AS total_revenue

		FROM sales_teams st
		JOIN Sales_pipeline sp
			ON st.sales_agent = sp.sales_agent
		GROUP BY st.regional_office, st.manager, sp.sales_agent,DATETRUNC(YEAR, sp.close_date),DATETRUNC(month, sp.close_date)
		),

	Agent_monthly_analysis AS (
		SELECT
			*,
			LAG(total_revenue, 1) OVER(
			PARTITION BY sales_agent
			ORDER BY close_month
		) AS prev_month_revenue,
			LAG(deals_won, 1) OVER(PARTITION BY sales_agent
			ORDER BY close_month
		)AS prev_month_deals_won,
			ROUND(
			AVG(total_revenue) OVER(
			PARTITION BY sales_agent
			ORDER BY close_month ROWS BETWEEN 2 PRECEDING AND CURRENT ROW
			), 2 
			) AS quarterly_rolling_avg
	FROM agent_performance
)
		
		SELECT
			regional_office, 
			sales_agent,
			close_year, 
			close_month,
			total_opportunities,
			deals_won,
			prev_month_deals_won,
			total_revenue,
			prev_month_revenue,
			quarterly_rolling_avg,
			ROUND(
				(total_revenue - COALESCE(prev_month_revenue, 0)) * 100.0 / NULLIF(prev_month_revenue, 0),
				2) AS rev_mom_growth_pct,
			DENSE_RANK() OVER(PARTITION BY regional_office, close_month 
			ORDER BY CASE WHEN total_revenue IS NULL OR total_revenue = 0 THEN 0 ELSE 1 END DESC, 
				total_revenue DESC
		 ) AS regional_monthly_rank
		FROM agent_monthly_analysis
		WHERE close_month IS NOT NULL
		ORDER BY regional_office, close_month, regional_monthly_rank


		---Yearly agent performance

		WITH Agent_performance AS (
		SELECT
			st.regional_office,
			st.manager,
			sp.sales_agent,
			COUNT(DISTINCT sp.opportunity_id) AS total_opportunities,
			COUNT(
				CASE WHEN sp.deal_stage = 'Won' THEN 1
			END) AS deals_won,
			SUM(CASE
				WHEN sp.deal_stage = 'Won'
				THEN sp.close_value
				ELSE 0
			END) AS total_revenue

		FROM sales_teams st
		JOIN Sales_pipeline sp
			ON st.sales_agent = sp.sales_agent
		GROUP BY st.regional_office, st.manager, sp.sales_agent
		)

		
		SELECT
			*,
			DENSE_RANK() OVER(PARTITION BY regional_office ORDER BY total_revenue DESC
			) AS regional_rank
		FROM Agent_performance
		ORDER BY regional_office, regional_rank

		-- Month over month regional performance
			WITH Agent_performance AS (
		SELECT
			st.regional_office,
			st.manager,
			sp.sales_agent,
			DATETRUNC(YEAR, sp.close_date) AS close_year,
			COUNT(DISTINCT sp.opportunity_id) AS total_opportunities,
			COUNT(
				CASE WHEN sp.deal_stage = 'Won' THEN 1
			END) AS deals_won,
			SUM(CASE
				WHEN sp.deal_stage = 'Won'
				THEN sp.close_value
				ELSE 0
			END) AS total_revenue

		FROM sales_teams st
		JOIN Sales_pipeline sp
			ON st.sales_agent = sp.sales_agent
		GROUP BY st.regional_office, st.manager, sp.sales_agent,DATETRUNC(YEAR, sp.close_date)
		),

	Agent_yearly_analysis AS (
		SELECT
			*,
			LAG(total_revenue, 1) OVER(
			PARTITION BY sales_agent
			ORDER BY close_year
		) AS prev_year_revenue,
			LAG(deals_won, 1) OVER(PARTITION BY sales_agent
			ORDER BY close_year
		)AS prev_year_deals_won
	FROM agent_performance
)
		
		SELECT
			regional_office, 
			sales_agent,
			close_year, 
			total_opportunities,
			deals_won,
			prev_year_deals_won,
			total_revenue,
			prev_year_revenue,
			ROUND(
				(total_revenue - COALESCE(prev_year_revenue, 0)) * 100.0 / NULLIF(prev_year_revenue, 0),
				2) AS rev_mom_growth_pct,
			DENSE_RANK() OVER(PARTITION BY regional_office, close_year
			ORDER BY CASE WHEN total_revenue IS NULL OR total_revenue = 0 THEN 0 ELSE 1 END DESC, 
				total_revenue DESC
		 ) AS regional_yearly_rank
		FROM agent_yearly_analysis
		WHERE close_year IS NOT NULL
		ORDER BY regional_office, close_year, regional_yearly_rank

		--- TOP 10 Accounts' contribution to total sales

SELECT top 10
	account,
	SUM(close_value) AS total_sales,
	ROUND(
			100.0 * SUM(close_value)/ NULLIF (SUM(SUM(close_value)) OVER (), 0), 2
			) AS pct_of_total_sales

FROM Sales_pipeline
WHERE deal_stage = 'Won'
GROUP BY account
ORDER BY pct_of_total_sales DESC


-- Win rates by agents

SELECT
	sales_agent,
	COUNT(*) AS closed_deals,
	SUM(CASE
		WHEN deal_stage = 'Won' THEN 1
		ELSE 0
	END) AS deals_won,
	SUM(CASE WHEN deal_stage = 'Lost' THEN 1
		ELSE 0
	END) AS deals_lost,
	ROUND(
		100.0 * SUM(
			CASE WHEN deal_stage ='Won' THEN 1 ELSE 0
			END
			) /NULLIF(COUNT(*), 0),
			2
		) AS win_rate
	FROM Sales_pipeline
	WHERE deal_stage IN ('Won', 'Lost')
	GROUP BY sales_agent
	ORDER BY win_rate DESC

	--- Industry Analysis --Sector wise contribution to total sales
		
SELECT
	a.sector,
	ROUND(
			100.0 * SUM(sp.close_value)/ NULLIF (SUM(SUM(sp.close_value)) OVER (), 0), 2
			) AS pct_of_total_sales
	
FROM Sales_pipeline sp
JOIN accounts a
	ON sp.account = a.account
WHERE deal_stage = 'Won'
GROUP BY a.sector
ORDER BY pct_of_total_sales DESC

----Discount on products

SELECT
	p.product,
	sp.close_value,
	p.sales_price,
	(p.sales_price - sp.close_value) AS discount
FROM Sales_pipeline sp
JOIN products p
	ON sp.product = p.product 
WHERE sp.deal_stage = 'Won'

---Average weeks to close
SELECT
	st.manager,
	COUNT(*) AS won_deals,
	 COUNT(sp.engage_date) AS deals_with_engage_date,
    COUNT(sp.close_date) AS deals_with_close_date,
        CAST(AVG(DATEDIFF(WEEK, sp.engage_date, sp.close_date))AS DECIMAL (8, 3))
        AS avg_weeks_to_close
FROM Sales_teams st
JOIN Sales_pipeline sp
 ON sp.sales_agent = st.sales_agent
WHERE sp.deal_stage IN ('Won', 'Lost')
and sp.engage_date IS NOT NULL
AND sp.close_date IS NOT NULL
GROUP BY st.manager
ORDER BY  avg_weeks_to_close

